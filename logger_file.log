2026-09-01 23:10:29,146 - logger_setup - INFO - current_month_disbursement_micro_lap = 
SELECT
    Platform,
    disb_mon,
    Product_name,
    COALESCE(Platform, '') || COALESCE(product_name, '') AS concat,
    loan_count,
    amount_disb
FROM (
    SELECT 
        'KB' AS Platform,
        DATE(disbursed_date) AS disb_mon,
        erp_product_name AS product_name,
        COUNT(DISTINCT emi.loan_id) AS loan_count,
        CAST(SUM(CASE WHEN installment_number = 1 THEN kbnbfc_principaldue END) AS REAL) AS amount_disb
    FROM findata_kb_31_08_2026__yp_emi_data_tbl emi
    LEFT JOIN findata_kb_31_08_2026__yp_loan_dimensional_tbl ldt ON emi.loan_id = ldt.loan_id
    WHERE DATE(disbursed_date) BETWEEN '2026-08-01' AND '2026-08-31'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'Offline' AS Platform,
        DATE(disbursed_date) AS disb_mon,
        'Offline' AS product_name,
        COUNT(DISTINCT Curr_New_Account_No) AS loan_count,
        CAST(SUM(principal) AS REAL) AS amount_disb
    FROM findata_kb_31_08_2026__offline_loandata_tbl
    WHERE DATE(disbursed_date) BETWEEN '2026-08-01' AND '2026-08-31'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'DBL_LAP_TWL_POPSA_SCF' AS Platform,
        DATE(disbursed_date) AS disb_mon,
        ldt.erp_product_name AS product_name,
        COUNT(DISTINCT emi.loan_id) AS loan_count,
        CAST(SUM(CASE WHEN installment_number = 1 THEN principaldue END) AS REAL) AS amount_disb
    FROM findata_dbl_lap_31_08_2026__yp_emi_data_tbl emi
    LEFT JOIN findata_dbl_lap_31_08_2026__yp_loan_dimensional_tbl ldt ON emi.loan_id = ldt.loan_id
    WHERE DATE(disbursed_date) BETWEEN '2026-08-01' AND '2026-08-31'
      AND ldt.erp_product_name NOT IN ('LAP','MICRO_LAP')
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'DBL_LAP_TWL_POPSA_SCF' AS Platform,
        DATE(datetime(b.disbursedon, '+5 hours', '+30 minutes')) AS disb_mon,
        c.erp_product_name AS product_name,
        COUNT(a.kbloanid) AS loan_count,
        CAST(SUM(CASE
            WHEN trancheNo = 1 THEN (CAST(amount AS REAL) + CAST(agreementFees AS REAL) +
                                     CAST(processingFees AS REAL) + CAST(insuranceFee AS REAL) +
                                     CAST(gstFees AS REAL))
            ELSE CAST(amount AS REAL)
        END) AS REAL) AS amount_disb
    FROM findata_dbl_lap_31_08_2026__yp_loan a
    JOIN findata_dbl_lap_31_08_2026__yp_tranche_disbursals b ON a.id = b.loanid
    LEFT JOIN findata_dbl_lap_31_08_2026__yp_loan_dimensional_tbl c ON a.id = c.loan_id
    WHERE datetime(b.disbursedon, '+5 hours', '+30 minutes') >= '2026-08-01 00:00:00'
      AND datetime(b.disbursedon, '+5 hours', '+30 minutes') <= '2026-08-31 23:59:59'
      AND b.state = 87 AND c.erp_product_name IN ('LAP','MICRO_LAP')
    GROUP BY 1, 2, 3
    ORDER BY 1, 3, 2 DESC
);
2026-09-01 23:10:29,146 - logger_setup - INFO - current_month_collections_kb = 
SELECT
    Platform,
    collected_month,
    erp_product_name,
    COALESCE(Platform,'') || COALESCE(erp_product_name,'') AS concat,
    principal_collection_kbnbfc
FROM (
    SELECT 
        'KB' AS Platform,
        strftime('%Y-%m-%d', txndate) AS collected_month,
        erp_product_name,
        CAST(SUM(COALESCE(kbnbfc_principal_paid, 0)) AS REAL) AS principal_collection_kbnbfc
    FROM findata_kb_31_08_2026__yp_collections_data_tbl col
    LEFT JOIN findata_kb_31_08_2026__yp_loan_dimensional_tbl ldt ON col.loanid = ldt.loan_id
    WHERE DATE(txndate) BETWEEN '2026-08-01' AND '2026-08-31'
      AND ldt.product_name != 'CARD'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'KB' AS Platform,
        strftime('%Y-%m-%d', principal_paid_date) AS collected_month,
        'CARD' AS erp_product_name,
        CAST(SUM(principal_paid) AS REAL) AS principal_collection_kbnbfc
    FROM findata_kb_31_08_2026__card_new_recon
    WHERE DATE(principal_paid_date) BETWEEN '2026-08-01' AND '2026-08-31'
      AND purchase_type IN ('purchase', 'bankWithdrawal')
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'KZ' AS Platform,
        strftime('%Y-%m-%d', emi_partital_paid_date) AS collected_month,
        'KZ' AS erp_product_name,
        CAST(SUM(principal_paid) AS REAL) AS principal_collection_kbnbfc
    FROM findata_kz_31_08_2026__yp_emi_data_tbl a
    WHERE emi_partital_paid_date BETWEEN '2026-08-01 00:00:00' AND '2026-08-31 23:59:59'
      AND fund_name IN ('KB', 'KBP')
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'offline' AS Platform,
        strftime('%Y-%m-%d', paid_date) AS collected_month,
        'offline' AS erp_product_name,
        CAST(SUM(principalpaid) AS REAL) AS principal_collection_kbnbfc
    FROM findata_kb_31_08_2026__offline_loandata_tbl
    WHERE DATE(paid_date) BETWEEN '2026-08-01' AND '2026-08-31'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'DBL_LAP_TWL_POPSA_SCF' AS Platform,
        strftime('%Y-%m-%d', txndate) AS collected_month,
        ldt.erp_product_name,
        CAST(SUM(COALESCE(principal_paid, 0)) AS REAL) AS principal_collection_kbnbfc
    FROM findata_dbl_lap_31_08_2026__yp_collections_data_tbl col
    LEFT JOIN findata_dbl_lap_31_08_2026__yp_loan_dimensional_tbl ldt ON col.loanid = ldt.loan_id
    WHERE DATE(txndate) BETWEEN '2026-08-01' AND '2026-08-31'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'Krazybee_Student' AS Platform,
        strftime('%Y-%m-%d', paiddate) AS collected_month,
        'Krazybee_Student' AS erp_product_name,
        CAST(SUM(PrincipalPaid) AS REAL) AS principal_collection_kbnbfc
    FROM findata_stu_31_08_2026__temp_all_emi_all_vw
    WHERE paiddate BETWEEN '2026-08-01 00:00:00' AND '2026-08-31 23:59:59'
      AND fund_name = 'KBNBFC'
    GROUP BY 1, 2

    ORDER BY 1, 3, 2 DESC
);
