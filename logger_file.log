SELECT
    Platform,
    snapshot_date,
    erp_product_name,
    COALESCE(Platform, '') || COALESCE(erp_product_name, '') AS concat,
    kbnbfc_pos
FROM (
    SELECT
        'KB' AS Platform,
        strftime('%Y-%m', snapshot_date) AS snapshot_date,
        erp_product_name,
        CAST(SUM(kbnbfc_pos) AS REAL) AS kbnbfc_pos
    FROM summary_kb__AUM_loan_snapshot_2_res_3 aum
    JOIN findata_kb_31_07_2026__yp_loan_dimensional_tbl ldt ON aum.loan_id = ldt.loan_id
    WHERE snapshot_date = '2026-07-31' AND aum.product_name <> 'CARD'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT
        'KB' AS Platform,
        strftime('%Y-%m', a.snapshot_date) AS snapshot_date,
        'CARD' AS erp_product_name,
        CAST(SUM(kbnbfc_pos) AS REAL) AS kbnbfc_pos
    FROM summary_kb__AUM_loan_snapshot_2_res_3 a
    JOIN findata_kb_31_07_2026__yp_loan_dimensional_tbl AS t3 ON (a.purchaseid = t3.purchase_id)
    WHERE a.snapshot_date = '2026-07-31' AND a.product_name = 'CARD'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT
        'KZ' AS Platform,
        strftime('%Y-%m', snapshot_date) AS snapshot_date,
        'KZ' AS erp_product_name,
        CAST(SUM(pos) AS REAL) AS kbnbfc_pos
    FROM summary_kz__AUM_loan_snapshot_2_res_3 aum
    WHERE snapshot_date = '2026-07-31' AND fund_name IN ('KB','KBP')
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'Offline' AS Platform,
        '' AS snapshot_date,
        'Offline' AS erp_product_name,
        CAST(SUM(principal) AS REAL) AS kbnbfc_pos
    FROM findata_kb_31_07_2026__offline_loandata_tbl 
    WHERE paid_date IS NULL
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'DBL_LAP_TWL_POPSA_SCF' AS Platform,
        strftime('%Y-%m', snapshot_date) AS snapshot_date,
        ldt.erp_product_name AS erp_product_name,
        CAST(SUM(kbnbfc_pos) AS REAL) AS kbnbfc_pos
    FROM summary_kb__DBL_LAP_offline_aum_loan_snapshot aum
    LEFT JOIN findata_dbl_lap_31_07_2026__yp_loan_dimensional_tbl ldt ON aum.loan_id = ldt.loan_id
    WHERE snapshot_date = '2026-07-31' AND platform <> 'Offline'
    GROUP BY 1, 2, 3
);
