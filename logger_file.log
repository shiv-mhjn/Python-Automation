SELECT 
    'KB' AS Platform,
    ldt.erp_product_name,
    COUNT(DISTINCT ldt.loan_id) AS Loan_count,
    COUNT(emi.id) AS Installment_count
FROM findata_kb_31_08_2026__yp_loan_dimensional_tbl ldt
JOIN findata_kb_31_08_2026__yp_loan_installments emi ON emi.loanid = ldt.loan_id
GROUP BY 1, 2

UNION ALL

SELECT 
    'KZ' AS Platform,
    l.productname,
    COUNT(DISTINCT l.id) AS Loan_Count,
    COUNT(li.id) AS Installment_count
FROM findata_kz_31_08_2026__yp_loan l
JOIN findata_kz_31_08_2026__yp_loan_installments li ON l.id = li.loanid
GROUP BY 1, 2

UNION ALL

SELECT 
    'DBL_LAP_TWL_POPSA_SCF' AS Platform,
    ldt.product_name,
    COUNT(DISTINCT emi.loanid) AS loan_count,
    COUNT(emi.id) AS Installment_count
FROM findata_dbl_lap_31_08_2026__yp_loan_installments emi
LEFT JOIN findata_dbl_lap_31_08_2026__yp_loan_dimensional_tbl ldt ON emi.loanid = ldt.loan_id
GROUP BY 1, 2

UNION ALL

SELECT 
    'Offline' AS Platform,
    '' AS product_name,
    COUNT(DISTINCT Curr_New_Account_No) AS loan_count,
    COUNT(*) AS installment_count
FROM findata_kb_31_08_2026__offline_loandata_tbl
GROUP BY 1, 2

UNION ALL

SELECT 
    'Krazybee-Stu' AS Platform,
    '' AS product_name,
    COUNT(DISTINCT OrderID) AS loan_count,
    COUNT(*) AS installment_count
FROM findata_stu_31_08_2026__temp_all_emi_all_vw
GROUP BY 1, 2

ORDER BY 1, 2;
