SELECT
    Platform,
    disb_mon,
    Product_name,
    COALESCE(Platform, '') || COALESCE(product_name, '') AS concat,
    loan_count,
    amount_disb
FROM (
    SELECT 
        'KB' AS Platform,
        DATE(disbursed_date) AS disb_mon,
        erp_product_name AS product_name,
        COUNT(DISTINCT emi.loan_id) AS loan_count,
        CAST(SUM(CASE WHEN installment_number = 1 THEN kbnbfc_principaldue END) AS REAL) AS amount_disb
    FROM findata_kb_31_08_2026__yp_emi_data_tbl emi
    LEFT JOIN findata_kb_31_08_2026__yp_loan_dimensional_tbl ldt ON emi.loan_id = ldt.loan_id
    WHERE DATE(disbursed_date) BETWEEN '2026-08-01' AND '2026-08-31'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'Offline' AS Platform,
        DATE(disbursed_date) AS disb_mon,
        'Offline' AS product_name,
        COUNT(DISTINCT Curr_New_Account_No) AS loan_count,
        CAST(SUM(principal) AS REAL) AS amount_disb
    FROM findata_kb_31_08_2026__offline_loandata_tbl
    WHERE DATE(disbursed_date) BETWEEN '2026-08-01' AND '2026-08-31'
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'DBL_LAP_TWL_POPSA_SCF' AS Platform,
        DATE(disbursed_date) AS disb_mon,
        ldt.erp_product_name AS product_name,
        COUNT(DISTINCT emi.loan_id) AS loan_count,
        CAST(SUM(CASE WHEN installment_number = 1 THEN principaldue END) AS REAL) AS amount_disb
    FROM findata_dbl_lap_31_08_2026__yp_emi_data_tbl emi
    LEFT JOIN findata_dbl_lap_31_08_2026__yp_loan_dimensional_tbl ldt ON emi.loan_id = ldt.loan_id
    WHERE DATE(disbursed_date) BETWEEN '2026-08-01' AND '2026-08-31'
      AND ldt.erp_product_name NOT IN ('LAP','MICRO_LAP')
    GROUP BY 1, 2, 3

    UNION ALL

    SELECT 
        'DBL_LAP_TWL_POPSA_SCF' AS Platform,
        DATE(datetime(b.disbursedon, '+5 hours', '+30 minutes')) AS disb_mon,
        c.erp_product_name AS product_name,
        COUNT(a.kbloanid) AS loan_count,
        CAST(SUM(CASE
            WHEN trancheNo = 1 THEN (CAST(amount AS REAL) + CAST(agreementFees AS REAL) +
                                     CAST(processingFees AS REAL) + CAST(insuranceFee AS REAL) +
                                     CAST(gstFees AS REAL))
            ELSE CAST(amount AS REAL)
        END) AS REAL) AS amount_disb
    FROM findata_dbl_lap_31_08_2026__yp_loan a
    JOIN findata_dbl_lap_31_08_2026__yp_tranche_disbursals b ON a.id = b.loanid
    LEFT JOIN findata_dbl_lap_31_08_2026__yp_loan_dimensional_tbl c ON a.id = c.loan_id
    WHERE datetime(b.disbursedon, '+5 hours', '+30 minutes') >= '2026-08-01 00:00:00'
      AND datetime(b.disbursedon, '+5 hours', '+30 minutes') <= '2026-08-31 23:59:59'
      AND b.state = 87 AND c.erp_product_name IN ('LAP','MICRO_LAP')
    GROUP BY 1, 2, 3
    ORDER BY 1, 3, 2 DESC
);
